pipeline {
    agent any

    stages {

        stage('Pull Git Code') {
            steps {
                git branch: 'develop', url: 'https://github.com/devops6154/Jenkins-project.git'
            }
        }

        stage('Create Folder') {
            steps {
                sh 'mkdir -p deploy-folder'
            }
        }

        stage('Copy Files') {
            steps {
                sh 'cp -r $(ls | grep -v deploy-folder) deploy-folder/'
            }
        }

    }
}
